{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poreen",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "build": {
    "command": "node scripts/bundle-static.mjs",
    "watch_dir": "public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "poreen",
      "database_id": "0a117062-d784-4eab-be62-b33ae0f54b1e",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "CLUB_NAME": "Panthers",
    "CHALLENGE_START": "2026-11-24"
  }
  // Secret (optional): CLUB_CODE — set with `npx wrangler secret put CLUB_CODE`.
  // When set, runners must enter it to log a run.
}
